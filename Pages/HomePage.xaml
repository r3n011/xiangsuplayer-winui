<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PixelPlayer.WinUI.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16" Padding="28,20,28,40">

            <TextBlock Text="主页" Style="{StaticResource PageTitle}" />

            <!-- 统计卡片 -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource DemoCard}" Grid.Column="0">
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="TrackCount" Text="0" Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock Text="首曲目" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource DemoCard}" Grid.Column="1">
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="AlbumCount" Text="0" Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock Text="张专辑" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource DemoCard}" Grid.Column="2">
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="ArtistCount" Text="0" Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock Text="位艺术家" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource DemoCard}" Grid.Column="3">
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="TodayPlays" Text="0" Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock Text="今日已听" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 快速开始 -->
            <Border Style="{StaticResource DemoCard}">
                <StackPanel Spacing="10">
                    <TextBlock Text="快速开始" Style="{StaticResource CardTitle}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="播放全部" Style="{StaticResource AccentButtonStyle}" Click="PlayAll_Click" />
                        <Button Content="随机播放" Click="ShuffleAll_Click" />
                        <Button x:Name="BtnDaily" Content="播放每日推荐" Click="DailyPlay_Click" />
                        <Button Content="刷新" Click="Refresh_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 每日推荐 -->
            <Border Style="{StaticResource DemoCard}" x:Name="DailyCard">
                <StackPanel Spacing="10">
                    <Grid>
                        <TextBlock Text="每日推荐" Style="{StaticResource CardTitle}" />
                    </Grid>
                    <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <ItemsControl x:Name="DailyList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="12" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Width="130" Tapped="DailyItem_Tapped" PointerPressed="DailyItem_PointerPressed">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Border Grid.Row="0" Width="126" Height="126" CornerRadius="8" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                                <Grid>
                                                    <FontIcon Glyph="&#xE8D6;" FontSize="22" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                    <Image Source="{Binding CoverThumb}" Stretch="UniformToFill" />
                                                </Grid>
                                            </Border>
                                            <TextBlock Grid.Row="1" Text="{Binding Title}" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" MaxWidth="126" Margin="0,5,0,0" />
                                            <TextBlock Grid.Row="2" Text="{Binding Artist}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="126" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- 最近播放 -->
            <Border Style="{StaticResource DemoCard}">
                <StackPanel Spacing="10">
                    <TextBlock Text="最近播放" Style="{StaticResource CardTitle}" />
                    <ListView x:Name="RecentList" MaxHeight="300" IsItemClickEnabled="True" SelectionMode="None" ItemClick="Recent_ItemClick">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="12" Padding="2,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="4" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                        <Image Source="{Binding CoverThumb}" Stretch="UniformToFill" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource BodyTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding DurationText}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="EmptyHint" Text="暂无播放记录" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <!-- 最多播放 -->
            <Border Style="{StaticResource DemoCard}" x:Name="MostPlayedCard" Visibility="Collapsed">
                <StackPanel Spacing="10">
                    <TextBlock Text="最多播放" Style="{StaticResource CardTitle}" />
                    <ListView x:Name="MostPlayedList" MaxHeight="280" IsItemClickEnabled="True" SelectionMode="None" ItemClick="MostPlayed_ItemClick">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="12" Padding="2,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="4" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                        <Image Source="{Binding Track.CoverThumb}" Stretch="UniformToFill" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding Count}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" MinWidth="28" />
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Text="{Binding Track.Title}" Style="{StaticResource BodyTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Track.Artist}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="3" Text="{Binding Track.DurationText}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
