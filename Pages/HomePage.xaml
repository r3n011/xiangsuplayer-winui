<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PixelPlayer.WinUI.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Page.Resources>
        <!-- 商店式封面卡：横滑行内的一张卡（封面 1:1 + 歌名 + 歌手） -->
        <DataTemplate x:Key="CoverCardTemplate">
            <Grid Width="150" Margin="0,0,4,0" Tapped="Card_Tapped" PointerPressed="Card_PointerPressed"
                  ToolTipService.ToolTip="{Binding ToolTipText}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Width="150" Height="150" CornerRadius="10" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                    <Grid>
                        <FontIcon Glyph="&#xE8D6;" FontSize="26" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <Image Source="{Binding CoverImage}" Stretch="UniformToFill" />
                    </Grid>
                </Border>
                <TextBlock Grid.Row="1" Text="{Binding Title}" Style="{StaticResource BodyTextBlockStyle}" TextTrimming="CharacterEllipsis" MaxWidth="150" Margin="2,7,0,0" />
                <TextBlock Grid.Row="2" Text="{Binding Subtitle}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="150" Margin="2,1,0,0" />
            </Grid>
        </DataTemplate>

        <!-- 排行卡（#N 徽章，对应参照 RankRow/TrendingRankSection） -->
        <DataTemplate x:Key="RankCardTemplate">
            <Grid Width="150" Margin="0,0,4,0" Tapped="Card_Tapped" PointerPressed="Card_PointerPressed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Width="150" Height="150" CornerRadius="10" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                    <Grid>
                        <FontIcon Glyph="&#xE8D6;" FontSize="26" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <Image Source="{Binding CoverImage}" Stretch="UniformToFill" />
                        <Border Background="#CC000000" CornerRadius="10,0,14,0" Padding="7,2" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="6,6,0,0">
                            <TextBlock Text="{Binding RankText}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="#FFFFFF" />
                        </Border>
                    </Grid>
                </Border>
                <TextBlock Grid.Row="1" Text="{Binding Title}" Style="{StaticResource BodyTextBlockStyle}" TextTrimming="CharacterEllipsis" MaxWidth="150" Margin="2,7,0,0" />
                <TextBlock Grid.Row="2" Text="{Binding Subtitle}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="150" Margin="2,1,0,0" />
            </Grid>
        </DataTemplate>

        <!-- 歌单卡 -->
        <DataTemplate x:Key="PlaylistCardTemplate">
            <Grid Width="150" Margin="0,0,4,0" Tapped="PlaylistCard_Tapped" PointerPressed="PlaylistCard_PointerPressed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Width="150" Height="150" CornerRadius="10" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                    <Grid>
                        <FontIcon Glyph="&#xE8FD;" FontSize="26" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <Image Source="{Binding CoverImage}" Stretch="UniformToFill" />
                    </Grid>
                </Border>
                <TextBlock Grid.Row="1" Text="{Binding Title}" Style="{StaticResource BodyTextBlockStyle}" TextTrimming="CharacterEllipsis" MaxWidth="150" Margin="2,7,0,0" />
                <TextBlock Grid.Row="2" Text="{Binding Subtitle}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="150" Margin="2,1,0,0" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer x:Name="RootScroll" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="RootStack" Spacing="18" Padding="28,20,28,40">

            <TextBlock Text="主页" Style="{StaticResource PageTitle}" />

            <!-- 精选 Hero（微软商店式：左大卡 + 右侧卡组；对应参照 FeaturedCarouselSection 平板形态） -->
            <Grid x:Name="HeroGrid" Height="360" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <!-- 主打大卡 -->
                <Border Grid.Column="0" CornerRadius="12" Background="{ThemeResource ControlFillColorSecondaryBrush}"
                        PointerPressed="Hero_PointerPressed" x:Name="HeroMain">
                    <Grid>
                        <Image x:Name="HeroMainCover" Stretch="UniformToFill" />
                        <!-- 底部渐变压字（对应 FeaturedCardScrim） -->
                        <Border>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0.45" />
                                    <GradientStop Color="#CC000000" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel VerticalAlignment="Bottom" Margin="20,0,20,16" Spacing="4">
                                <TextBlock x:Name="HeroMainBadge" Text="精选推荐" Style="{StaticResource CaptionTextBlockStyle}" Foreground="#CCFFFFFF" />
                                <TextBlock x:Name="HeroMainTitle" Text="" Style="{StaticResource TitleTextBlockStyle}" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="HeroMainArtist" Text="" Style="{StaticResource BodyTextBlockStyle}" Foreground="#B3FFFFFF" TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
                                    <Button x:Name="HeroPlayBtn" Style="{StaticResource AccentButtonStyle}" Click="HeroPlay_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE768;" FontSize="14" />
                                            <TextBlock Text="播放" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="HeroQueue_Click" Background="#66FFFFFF" Foreground="#FFFFFF">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE710;" FontSize="14" />
                                            <TextBlock Text="加入队列" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- 右侧卡组：1 中卡 + 2 小卡（商店布局） -->
                <StackPanel Grid.Column="1" Spacing="12">
                    <Border CornerRadius="12" Height="174" Background="{ThemeResource ControlFillColorSecondaryBrush}"
                            PointerPressed="SideCard_PointerPressed" Tag="1" x:Name="HeroSide1">
                        <Grid>
                            <Image x:Name="HeroSide1Cover" Stretch="UniformToFill" />
                            <Border>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#00000000" Offset="0.5" />
                                        <GradientStop Color="#B3000000" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <StackPanel VerticalAlignment="Bottom" Margin="12,0,12,8" Spacing="2">
                                    <TextBlock x:Name="HeroSide1Title" Text="" Style="{StaticResource BodyStrongTextBlockStyle}" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="HeroSide1Artist" Text="" Style="{StaticResource CaptionTextBlockStyle}" Foreground="#B3FFFFFF" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                    <Grid ColumnSpacing="12" Height="174">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" CornerRadius="12" Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                PointerPressed="SideCard_PointerPressed" Tag="2" x:Name="HeroSide2">
                            <Grid>
                                <Image x:Name="HeroSide2Cover" Stretch="UniformToFill" />
                                <Border>
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#00000000" Offset="0.5" />
                                            <GradientStop Color="#B3000000" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <StackPanel VerticalAlignment="Bottom" Margin="10,0,10,8" Spacing="2">
                                        <TextBlock x:Name="HeroSide2Title" Text="" Style="{StaticResource CaptionTextBlockStyle}" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="HeroSide2Artist" Text="" Style="{StaticResource CaptionTextBlockStyle}" Foreground="#99FFFFFF" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" CornerRadius="12" Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                PointerPressed="SideCard_PointerPressed" Tag="3" x:Name="HeroSide3">
                            <Grid>
                                <Image x:Name="HeroSide3Cover" Stretch="UniformToFill" />
                                <Border>
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#00000000" Offset="0.5" />
                                            <GradientStop Color="#B3000000" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <StackPanel VerticalAlignment="Bottom" Margin="10,0,10,8" Spacing="2">
                                        <TextBlock x:Name="HeroSide3Title" Text="" Style="{StaticResource CaptionTextBlockStyle}" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="HeroSide3Artist" Text="" Style="{StaticResource CaptionTextBlockStyle}" Foreground="#99FFFFFF" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- 快速开始（精简成一行按钮） -->
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="播放全部" Style="{StaticResource AccentButtonStyle}" Click="PlayAll_Click" />
                <Button Content="随机播放" Click="ShuffleAll_Click" />
                <Button Content="刷新" Click="Refresh_Click" />
            </StackPanel>

            <!-- 宽屏双列容器（对应参照 tablet_two_column_cards） -->
            <Grid x:Name="WideGrid" ColumnSpacing="16" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="WideColA" Grid.Column="0" Spacing="18" />
                <StackPanel x:Name="WideColB" Grid.Column="1" Spacing="18" />
            </Grid>

            <!-- 窄屏单列容器 -->
            <StackPanel x:Name="NarrowStack" Spacing="18">

                <!-- 最近播放（横滑卡片行） -->
                <StackPanel x:Name="RecentSection" Spacing="10">
                    <TextBlock Text="最近播放" Style="{StaticResource CardTitle}" />
                    <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ItemsControl x:Name="RecentCards" ItemTemplate="{StaticResource CoverCardTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                    <TextBlock x:Name="EmptyHint" Text="暂无播放记录" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <!-- 每日推荐（横滑卡片行） -->
                <StackPanel x:Name="DailySection" Spacing="10" Visibility="Collapsed">
                    <TextBlock Text="每日推荐" Style="{StaticResource CardTitle}" />
                    <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="DailyCards" ItemTemplate="{StaticResource CoverCardTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>

                <!-- 最多播放（#N 排行卡横滑行，对应 TrendingRankSection） -->
                <StackPanel x:Name="MostSection" Spacing="10" Visibility="Collapsed">
                    <TextBlock Text="最多播放" Style="{StaticResource CardTitle}" />
                    <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="MostCards" ItemTemplate="{StaticResource RankCardTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>

                <!-- 我的歌单（云端 + 本地） -->
                <StackPanel x:Name="PlaylistsSection" Spacing="10" Visibility="Collapsed">
                    <TextBlock Text="我的歌单" Style="{StaticResource CardTitle}" />
                    <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="PlaylistCards" ItemTemplate="{StaticResource PlaylistCardTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
