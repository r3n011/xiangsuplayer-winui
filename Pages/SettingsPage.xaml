<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PixelPlayer.WinUI.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16" Padding="28,20,28,40">

            <TextBlock Text="设置" Style="{StaticResource PageTitle}" />

            <Grid ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Button Tag="playback" Click="Category_Click" Style="{StaticResource CategoryCard}" Grid.Row="0" Grid.Column="0">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE768;" FontSize="20" />
                        <StackPanel>
                            <TextBlock Text="播放" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="倍速、睡眠定时器、无缝播放" Style="{StaticResource CardDesc}" Margin="0,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Button>

                <Button Tag="appearance" Click="Category_Click" Style="{StaticResource CategoryCard}" Grid.Row="0" Grid.Column="1">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE790;" FontSize="20" />
                        <StackPanel>
                            <TextBlock Text="外观" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="主题、强调色" Style="{StaticResource CardDesc}" />
                        </StackPanel>
                    </StackPanel>
                </Button>

                <Button Tag="library" Click="Category_Click" Style="{StaticResource CategoryCard}" Grid.Row="0" Grid.Column="2">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE8B7;" FontSize="20" />
                        <StackPanel>
                            <TextBlock Text="音乐管理" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="扫描文件夹、排除目录" Style="{StaticResource CardDesc}" />
                        </StackPanel>
                    </StackPanel>
                </Button>

                <Button Tag="equalizer" Click="Category_Click" Style="{StaticResource CategoryCard}" Grid.Row="1" Grid.Column="0">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE9E9;" FontSize="20" />
                        <StackPanel>
                            <TextBlock Text="均衡器" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="10 段 EQ、预设、低音增强" Style="{StaticResource CardDesc}" />
                        </StackPanel>
                    </StackPanel>
                </Button>

                <Button Tag="ai" Click="Category_Click" Style="{StaticResource CategoryCard}" Grid.Row="1" Grid.Column="1">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE99A;" FontSize="20" />
                        <StackPanel>
                            <TextBlock Text="AI 集成（β）" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="服务商、API Key、模型、歌单生成" Style="{StaticResource CardDesc}" />
                        </StackPanel>
                    </StackPanel>
                </Button>

                <Button Tag="sources" Click="Category_Click" Style="{StaticResource CategoryCard}" Grid.Row="1" Grid.Column="2">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE71A;" FontSize="20" />
                        <StackPanel>
                            <TextBlock Text="在线音源" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="音源脚本、音源市场、自建服务器" Style="{StaticResource CardDesc}" />
                        </StackPanel>
                    </StackPanel>
                </Button>

                <Button Tag="backup" Click="Category_Click" Style="{StaticResource CategoryCard}" Grid.Row="2" Grid.Column="0">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE898;" FontSize="20" />
                        <StackPanel>
                            <TextBlock Text="备份与恢复" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="导出/导入设置、歌单与统计" Style="{StaticResource CardDesc}" />
                        </StackPanel>
                    </StackPanel>
                </Button>

                <Button Tag="about" Click="Category_Click" Style="{StaticResource CategoryCard}" Grid.Row="2" Grid.Column="1">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE946;" FontSize="20" />
                        <StackPanel>
                            <TextBlock Text="关于" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="版本信息与开源说明" Style="{StaticResource CardDesc}" />
                        </StackPanel>
                    </StackPanel>
                </Button>

                <Button Tag="webremote" Click="Category_Click" Style="{StaticResource CategoryCard}" Grid.Row="2" Grid.Column="2">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE8EA;" FontSize="20" />
                        <StackPanel>
                            <TextBlock Text="网页遥控" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="局域网内用手机/浏览器控制播放" Style="{StaticResource CardDesc}" />
                        </StackPanel>
                    </StackPanel>
                </Button>

                <Button Tag="floating" Click="Category_Click" Style="{StaticResource CategoryCard}" Grid.Row="3" Grid.Column="0">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE7F4;" FontSize="20" />
                        <StackPanel>
                            <TextBlock Text="悬浮歌词" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="桌面底部悬浮显示当前歌词" Style="{StaticResource CardDesc}" />
                        </StackPanel>
                    </StackPanel>
                </Button>

                <Button Tag="account" Click="Category_Click" Style="{StaticResource CategoryCard}" Grid.Row="3" Grid.Column="1">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE77B;" FontSize="20" />
                        <StackPanel>
                            <TextBlock Text="账号" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="网易云登录与云歌单同步" Style="{StaticResource CardDesc}" />
                        </StackPanel>
                    </StackPanel>
                </Button>
            </Grid>

            <TextBlock Text="像素播放器 · WinUI 3 版" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Margin="2,8,0,0" />
        </StackPanel>
    </ScrollViewer>
</Page>
