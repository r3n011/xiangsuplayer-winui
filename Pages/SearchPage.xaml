<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PixelPlayer.WinUI.Pages.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
    <Grid RowSpacing="14" Padding="28,20,28,24" MaxWidth="1500">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox
                x:Name="SearchBox"
                PlaceholderText="搜索歌曲、专辑、艺术家、流派…"
                QueryIcon="Find"
                TextChanged="Search_TextChanged"
                Height="44" />
            <ComboBox
                x:Name="SourceBox"
                Grid.Column="1"
                Width="150"
                Height="44"
                DisplayMemberPath="Name"
                SelectedValuePath="Id"
                SelectionChanged="Source_SelectionChanged" />
        </Grid>

        <TextBlock Grid.Row="1" x:Name="SummaryText" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <ScrollViewer Grid.Row="2" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" Padding="0,4,0,0">
            <StackPanel Spacing="18">

                <!-- 艺术家 -->
                <StackPanel x:Name="ArtistsSection" Spacing="8" Visibility="Collapsed">
                    <TextBlock Text="艺术家" Style="{StaticResource CardTitle}" />
                    <ItemsControl x:Name="ArtistsList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="12" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Width="96" PointerPressed="ArtistResult_PointerPressed">
                                    <Border Width="88" Height="88" CornerRadius="44" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                        <Grid>
                                            <FontIcon Glyph="&#xE77B;" FontSize="22" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            <Image Source="{Binding CoverThumb}" Stretch="UniformToFill" />
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" Margin="0,5,0,0" MaxWidth="96" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- 专辑 -->
                <StackPanel x:Name="AlbumsSection" Spacing="8" Visibility="Collapsed">
                    <TextBlock Text="专辑" Style="{StaticResource CardTitle}" />
                    <ItemsControl x:Name="AlbumsList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="12" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Width="120" PointerPressed="AlbumResult_PointerPressed">
                                    <Border Width="112" Height="112" CornerRadius="8" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                        <Grid>
                                            <FontIcon Glyph="&#xE8D6;" FontSize="22" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            <Image Source="{Binding CoverThumb}" Stretch="UniformToFill" />
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" Margin="0,5,0,0" MaxWidth="120" />
                                    <TextBlock Text="{Binding Artist}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" MaxWidth="120" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- 歌曲 -->
                <StackPanel x:Name="SongsSection" Spacing="8" Visibility="Collapsed">
                    <TextBlock Text="歌曲" Style="{StaticResource CardTitle}" />
                    <ListView x:Name="TrackList" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="Track_ItemClick">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="12" Padding="2,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="4" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                        <Image Source="{Binding CoverThumb}" Stretch="UniformToFill" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource BodyTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding AlbumArtistText}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding DurationText}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>

                <TextBlock x:Name="EmptyHint" Text="未找到相关结果" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Visibility="Visible" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
