<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PixelPlayer.WinUI.Pages.LxMarketPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16" Padding="28,20,28,40" MaxWidth="1200" HorizontalAlignment="Left">

            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Click="Back_Click" Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72B;" FontSize="12" />
                        <TextBlock Text="返回" />
                    </StackPanel>
                </Button>
                <TextBlock Text="音源市场" Style="{StaticResource PageTitle}" VerticalAlignment="Center" />
            </StackPanel>

            <!-- ============ MarketIntroCard ============ -->
            <Border Style="{StaticResource DemoCard}">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="52" Height="52" CornerRadius="14" Background="{ThemeResource AccentFillColorDefaultBrush}">
                        <FontIcon Glyph="&#xE719;" FontSize="22" Foreground="White" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                        <TextBlock Text="像素音源市场" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="InstalledText" Text="已安装 0 个音源" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                        <ProgressRing x:Name="LoadingRing" Width="22" Height="22" IsActive="True" Visibility="Collapsed" />
                        <Button Content="刷新" Click="Refresh_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============ ReleaseCard 手风琴 ============ -->
            <ListView x:Name="ReleaseList" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource DemoCard}" Margin="0,2">
                            <StackPanel Spacing="10">
                                <!-- Release 头部：tag + 名称 + meta，点击展开 -->
                                <Grid PointerPressed="ReleaseHeader_PointerPressed" Tag="{Binding}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="3">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border CornerRadius="10" Padding="10,2" Background="{ThemeResource AccentFillColorDefaultBrush}">
                                                <TextBlock Text="{Binding TagName}" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                                            </Border>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding MetaText}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <FontIcon Grid.Column="1" Glyph="{Binding Chevron}" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                </Grid>

                                <!-- Release 展开体 -->
                                <StackPanel Spacing="8" Visibility="{Binding BodyVisibility}">
                                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Visibility="{Binding StatusVisibility}" />
                                    <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100" Visibility="{Binding ProgressVisibility}" />

                                    <TextBlock Text="{Binding Notes}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" MaxHeight="160" TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding NotesVisibility}" />

                                    <!-- 脚本行（Inspected 状态）：安装按钮 / 已安装 chip -->
                                    <ItemsControl ItemsSource="{Binding JsEntries}" Visibility="{Binding JsVisibility}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnSpacing="10" Padding="10,8" CornerRadius="{StaticResource ControlCornerRadius}"
                                                      Background="{ThemeResource ControlFillColorSecondaryBrush}" Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                                        <TextBlock Text="{Binding FileName}" Style="{StaticResource BodyTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding SizeText}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="安装" Click="Install_Click" Tag="{Binding}" VerticalAlignment="Center"
                                                            Visibility="{Binding InstallVisibility}" />
                                                    <Border Grid.Column="1" CornerRadius="10" Padding="10,4" VerticalAlignment="Center"
                                                            Background="{ThemeResource ControlFillColorDefaultBrush}" Visibility="{Binding InstalledVisibility}">
                                                        <TextBlock Text="已安装" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock x:Name="EmptyHint" Text="暂无 Release。点击「刷新」重试，或检查网络连接。"
                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Visibility="Collapsed" />
        </StackPanel>
    </ScrollViewer>
</Page>
