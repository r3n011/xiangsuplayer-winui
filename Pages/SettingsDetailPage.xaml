<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PixelPlayer.WinUI.Pages.SettingsDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="ContentPanel" Spacing="16" Padding="28,20,28,40" MaxWidth="1200" HorizontalAlignment="Left">

            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Click="Back_Click" Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72B;" FontSize="12" />
                        <TextBlock Text="返回" />
                    </StackPanel>
                </Button>
                <TextBlock x:Name="TitleText" Text="设置" Style="{StaticResource PageTitle}" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock x:Name="DescText" Style="{StaticResource CardDesc}" />

            <!-- ============ 播放 ============ -->
            <Border x:Name="SectionPlayback" Style="{StaticResource DemoCard}" Visibility="Collapsed">
                <StackPanel Spacing="12">
                    <TextBlock Text="播放控制" Style="{StaticResource CardTitle}" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="播放倍速" VerticalAlignment="Center" Width="120" />
                        <ComboBox x:Name="SpeedBox" Width="130" SelectionChanged="Speed_SelectionChanged">
                            <ComboBoxItem Content="0.5×" Tag="0.5" />
                            <ComboBoxItem Content="0.75×" Tag="0.75" />
                            <ComboBoxItem Content="1.0×" Tag="1" />
                            <ComboBoxItem Content="1.25×" Tag="1.25" />
                            <ComboBoxItem Content="1.5×" Tag="1.5" />
                            <ComboBoxItem Content="2.0×" Tag="2" />
                        </ComboBox>
                        <ToggleSwitch x:Name="PitchFollow" OnContent="变调跟随" OffContent="变调跟随" Margin="16,0,0,0" Toggled="PitchFollow_Toggled" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <ToggleSwitch x:Name="Gapless" OnContent="无缝播放" OffContent="无缝播放" Toggled="Gapless_Toggled" />
                        <ToggleSwitch x:Name="Crossfade" OnContent="交叉淡入淡出" OffContent="交叉淡入淡出" Toggled="Crossfade_Toggled" />
                        <TextBox x:Name="CrossfadeSeconds" Header="秒" Width="80" TextChanged="CrossfadeSeconds_TextChanged" />
                    </StackPanel>

                    <TextBlock Text="睡眠定时器" Style="{StaticResource CardTitle}" Margin="0,8,0,0" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <ComboBox x:Name="SleepBox" Width="150" SelectionChanged="Sleep_SelectionChanged">
                            <ComboBoxItem Content="关闭" Tag="0" />
                            <ComboBoxItem Content="15 分钟后" Tag="15" />
                            <ComboBoxItem Content="30 分钟后" Tag="30" />
                            <ComboBoxItem Content="60 分钟后" Tag="60" />
                            <ComboBoxItem Content="90 分钟后" Tag="90" />
                        </ComboBox>
                        <TextBlock x:Name="SleepStatus" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ============ 外观 ============ -->
            <Border x:Name="SectionAppearance" Style="{StaticResource DemoCard}" Visibility="Collapsed">
                <StackPanel Spacing="10">
                    <TextBlock Text="主题" Style="{StaticResource CardTitle}" />
                    <RadioButtons x:Name="ThemeChoice" SelectionChanged="Theme_SelectionChanged">
                        <RadioButton Content="跟随系统" Tag="Default" />
                        <RadioButton Content="浅色" Tag="Light" />
                        <RadioButton Content="深色" Tag="Dark" />
                    </RadioButtons>
                </StackPanel>
            </Border>

            <!-- ============ 音乐管理 ============ -->
            <Border x:Name="SectionLibrary" Style="{StaticResource DemoCard}" Visibility="Collapsed">
                <StackPanel Spacing="10">
                    <TextBlock Text="音乐文件夹" Style="{StaticResource CardTitle}" />

                    <Border CornerRadius="{StaticResource ControlCornerRadius}" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <ListView x:Name="FolderList" MaxHeight="190" SelectionMode="None" Padding="4">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnSpacing="10" Padding="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0" Glyph="&#xE8B7;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding}" Style="{StaticResource BodyTextBlockStyle}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <Button Grid.Column="2" Content="移除" Click="RemoveFolder_Click" Tag="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>

                    <TextBlock x:Name="EmptyFolderHint" Text="还没有添加文件夹。" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="添加文件夹" Click="AddFolder_Click" />
                        <Button x:Name="ScanButton" Content="扫描媒体库" Style="{StaticResource AccentButtonStyle}" Click="Scan_Click" />
                        <Button Content="清空曲库" Click="ClearLibrary_Click" />
                    </StackPanel>

                    <ProgressBar x:Name="ScanProgress" Visibility="Collapsed" />
                    <TextBlock x:Name="ScanStatus" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <!-- ============ 均衡器 ============ -->
            <Border x:Name="SectionEqualizer" Style="{StaticResource DemoCard}" Visibility="Collapsed">
                <StackPanel Spacing="10">
                    <TextBlock Text="均衡器与音效" Style="{StaticResource CardTitle}" />
                    <Button Content="打开均衡器" Style="{StaticResource AccentButtonStyle}" Click="OpenEqualizer_Click" />
                </StackPanel>
            </Border>

            <!-- ============ AI 集成 ============ -->
            <Border x:Name="SectionAi" Style="{StaticResource DemoCard}" Visibility="Collapsed">
                <StackPanel Spacing="10">
                    <TextBlock Text="AI 服务配置" Style="{StaticResource CardTitle}" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="服务商" VerticalAlignment="Center" Width="100" />
                        <ComboBox x:Name="AiProviderBox" Width="180" SelectionChanged="Ai_SelectionChanged">
                            <ComboBoxItem Content="OpenAI 兼容" />
                            <ComboBoxItem Content="Deepseek" />
                            <ComboBoxItem Content="Gemini" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="Base URL" VerticalAlignment="Center" Width="100" />
                        <TextBox x:Name="AiBaseUrl" Width="360" TextChanged="Ai_SelectionChanged" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="API Key" VerticalAlignment="Center" Width="100" />
                        <PasswordBox x:Name="AiApiKey" Width="360" PasswordChanged="Ai_SelectionChanged" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="模型" VerticalAlignment="Center" Width="100" />
                        <TextBox x:Name="AiModel" Width="360" TextChanged="Ai_SelectionChanged" />
                    </StackPanel>
                    <TextBlock x:Name="AiStatus" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button Content="测试连接" Click="AiTest_Click" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- ============ 在线音源 ============ -->
            <Border x:Name="SectionSources" Style="{StaticResource DemoCard}" Visibility="Collapsed">
                <StackPanel Spacing="10">
                    <TextBlock Text="自建媒体服务器" Style="{StaticResource CardTitle}" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="Jellyfin 服务器" VerticalAlignment="Center" Width="120" />
                        <TextBox x:Name="JellyfinServer" PlaceholderText="http://192.168.1.10:8096" Width="320" TextChanged="Sources_TextChanged" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="Jellyfin 用户" VerticalAlignment="Center" Width="120" />
                        <TextBox x:Name="JellyfinUser" Width="160" TextChanged="Sources_TextChanged" />
                        <PasswordBox x:Name="JellyfinPassword" Width="160" PasswordChanged="Sources_TextChanged" PlaceholderText="密码" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,6,0,0">
                        <TextBlock Text="Navidrome 服务器" VerticalAlignment="Center" Width="120" />
                        <TextBox x:Name="NavidromeServer" PlaceholderText="http://192.168.1.10:4533" Width="320" TextChanged="Sources_TextChanged" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="Navidrome 用户" VerticalAlignment="Center" Width="120" />
                        <TextBox x:Name="NavidromeUser" Width="160" TextChanged="Sources_TextChanged" />
                        <PasswordBox x:Name="NavidromePassword" Width="160" PasswordChanged="Sources_TextChanged" PlaceholderText="密码" />
                    </StackPanel>
                    <TextBlock Text="服务器需与电脑在同一网络；配置后可在搜索页音源下拉框中选择。" Style="{StaticResource CardDesc}" />

                    <TextBlock Text="下载" Style="{StaticResource CardTitle}" Margin="0,8,0,0" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="下载目录" VerticalAlignment="Center" Width="120" />
                        <TextBox x:Name="DownloadFolderBox" Width="440" PlaceholderText="留空使用默认（音乐\PixelPlayer）" TextChanged="Sources_TextChanged" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ============ 悬浮歌词 ============ -->
            <Border x:Name="SectionFloating" Style="{StaticResource DemoCard}" Visibility="Collapsed">
                <StackPanel Spacing="8">
                    <TextBlock Text="悬浮歌词" Style="{StaticResource CardTitle}" />
                    <ToggleSwitch x:Name="FloatingSwitch" OnContent="显示" OffContent="隐藏" Toggled="Floating_Toggled" />
                </StackPanel>
            </Border>

            <!-- ============ 网页遥控 ============ -->
            <Border x:Name="SectionWebRemote" Style="{StaticResource DemoCard}" Visibility="Collapsed">
                <StackPanel Spacing="10">
                    <TextBlock Text="网页遥控" Style="{StaticResource CardTitle}" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <ToggleSwitch x:Name="RemoteSwitch" OnContent="已启用" OffContent="已停用" Toggled="Remote_Toggled" />
                        <TextBox x:Name="RemotePort" Header="端口" Width="120" TextChanged="RemotePort_TextChanged" />
                    </StackPanel>
                    <TextBlock x:Name="RemoteStatus" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="打开遥控页" Click="OpenRemote_Click" />
                        <Button Content="复制地址" Click="CopyRemote_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ============ 备份与恢复 ============ -->
            <Border x:Name="SectionBackup" Style="{StaticResource DemoCard}" Visibility="Collapsed">
                <StackPanel Spacing="10">
                    <TextBlock Text="备份与恢复" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="导出/导入设置、播放列表与收听统计（JSON）。" Style="{StaticResource CardDesc}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="导出备份" Style="{StaticResource AccentButtonStyle}" Click="Export_Click" />
                        <Button Content="导入恢复" Click="Import_Click" />
                    </StackPanel>
                    <TextBlock x:Name="BackupStatus" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- ============ 关于 ============ -->
            <Border x:Name="SectionAbout" Style="{StaticResource DemoCard}" Visibility="Collapsed">
                <StackPanel Spacing="8">
                    <TextBlock Text="关于" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="像素播放器 · WinUI 3 版" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Style="{StaticResource CardDesc}" TextWrapping="Wrap"
                               Text="像素播放器（Android）的 Windows 桌面版，基于 WinUI 3 构建。" />
                    <TextBlock x:Name="AboutInfo" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
